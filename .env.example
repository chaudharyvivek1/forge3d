# Copy to .env and fill in what you use. Nothing here is required —
# forge3d runs fully offline with the procedural backend.

# where meshes, previews and job records are written
FORGE3D_WORKDIR=.forge3d

# auto | procedural | openscad | blender | cadquery | hosted
FORGE3D_BACKEND=auto

# allow agent-written Python to build geometry (the procedural backend)
FORGE3D_ALLOW_CODE_EXEC=true
FORGE3D_CODE_TIMEOUT=120

# face-count ceilings per delivery target
FORGE3D_MAX_FACES_WEB=250000
FORGE3D_MAX_FACES_GAME=60000
FORGE3D_MAX_FACES_PRINT=2000000

# hosted text-to-3D adapter (Meshy, Tripo, Rodin, or your own worker).
# See docs/backends.md — endpoint shapes differ per provider.
FORGE3D_HOSTED_URL=
FORGE3D_HOSTED_KEY=
FORGE3D_HOSTED_PROVIDER=generic
