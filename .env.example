# Copy to .env and fill in what you use. Nothing here is required —
# forge3d runs fully offline with the procedural backend.

# where meshes, previews and job records are written
FORGE3D_WORKDIR=.forge3d

# auto | procedural | openscad | blender | cadquery | hosted
FORGE3D_BACKEND=auto

# Allow caller-supplied code to run. This gates ALL THREE code-running backends
# (procedural, cadquery, blender) centrally — not just the procedural one.
# Turn this off when the MCP server is reachable by untrusted callers.
FORGE3D_ALLOW_CODE_EXEC=true
# wall-clock budget for one model build, in seconds
FORGE3D_CODE_TIMEOUT=120

# how model code runs: inprocess | subprocess | auto
#   inprocess  = exec() in the server (fast, no isolation, timeout only abandons)
#   subprocess = killable child with rlimits (real cancellation)
#   auto       = inprocess for stdio, subprocess for HTTP  <-- recommended
FORGE3D_EXEC_MODE=auto
# address-space ceiling for subprocess mode, MiB. 0 = off. See docs/security.md
FORGE3D_MEM_LIMIT_MB=0
# OS-level isolation: auto (bubblewrap if installed) | bwrap | unshare | none
FORGE3D_SANDBOX=auto
# largest file a single child may write, MiB
FORGE3D_MAX_FILE_MB=512

# --- reliability ---------------------------------------------------------
# generations allowed at once, and how long a request waits for a free slot
FORGE3D_MAX_CONCURRENT=2
FORGE3D_QUEUE_WAIT=30
# HTTP requests per minute per token/IP. 0 = off. Needs a proxy for real quotas.
FORGE3D_RATE_LIMIT=0
# hosted text-to-3D attempts (1 = no retry)
FORGE3D_HOSTED_RETRIES=3
# one JSON object per tool call and HTTP request on stderr
FORGE3D_LOG_JSON=0

# bearer token required by HTTP clients. A non-loopback bind REFUSES to start
# without it. Generate one with: openssl rand -hex 32
# FORGE3D_HTTP_TOKEN=

# face-count ceilings per delivery target
FORGE3D_MAX_FACES_WEB=250000
FORGE3D_MAX_FACES_GAME=60000
FORGE3D_MAX_FACES_PRINT=2000000

# --- text-to-3D providers (see docs/providers.md) ------------------------
# auto | generic | meshy | tripo | rodin.  `auto` picks the first configured.
FORGE3D_PROVIDER=auto

# commercial adapters — each needs its own key.
# These are UNVERIFIED against live accounts; run `forge3d providers --check`.
# FORGE3D_MESHY_KEY=
# FORGE3D_TRIPO_KEY=
# FORGE3D_RODIN_KEY=

# your own worker implementing forge3d's documented contract
# (examples/hosted_worker.py is a working reference)
FORGE3D_HOSTED_URL=
FORGE3D_HOSTED_KEY=
FORGE3D_HOSTED_PROVIDER=generic

# explicit binary paths — needed on Windows/macOS when an installer did not
# add itself to PATH. `forge3d doctor` tells you whether they are found.
# FORGE3D_OPENSCAD=C:\Program Files\OpenSCAD\openscad.com
# FORGE3D_BLENDER=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe

# --- outbound network limits --------------------------------------------
# Provider asset downloads are SSRF-checked like reference images. Cap the bytes
# and, optionally, restrict them to the domains you expect.
FORGE3D_MAX_DOWNLOAD_MB=512
# FORGE3D_TRUSTED_DOWNLOAD_HOSTS=cdn.meshy.ai,assets.tripo3d.ai
# Allow downloads from private addresses (needed only for a self-hosted worker
# on a LAN). Off by default: that is the SSRF hole.
FORGE3D_ALLOW_PRIVATE_DOWNLOAD=0
# A proxy resolves destinations itself, so IP pinning cannot apply. Set to false
# to refuse proxied fetches entirely.
FORGE3D_ALLOW_PROXY_FETCH=true

# where viewer pages load three.js from. Set this to a local mirror to make
# generated HTML work on an air-gapped machine (default: unpkg CDN).
# FORGE3D_THREE_URL=http://localhost:8080/three
